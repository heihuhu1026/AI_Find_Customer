# ============================================================
# AI Hunter — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Model (litellm format: "provider/model") ---
# Examples:
#   gpt-4o                              (OpenAI)
#   anthropic/claude-3-5-sonnet-20241022 (Anthropic)
#   openrouter/google/gemini-pro        (OpenRouter)
#   groq/llama-3.3-70b-versatile        (Groq)
#   zai/glm-4.7                         (GLM / 智谱 Z.AI)
#   moonshot/moonshot-v1-128k           (Kimi / Moonshot)
#   minimax/MiniMax-M2.1-highspeed      (MiniMax, recommended default)
LLM_MODEL=dashscope/qwen3.8-27b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_REQUESTS_PER_MINUTE=60
# --- Model fallback chain (auto-jump when a model is rate-limited / out of quota) ---
# Comma-separated litellm names. When LLM_MODEL is exhausted, the client auto-jumps
# to the next model here, then finally to CHEAP_MODEL (local Ollama) as 兜底.
# Bare names (no "/") are auto-prefixed with "dashscope/".
LLM_MODEL_FALLBACK=dashscope/qwen3.8-max-0902,dashscope/kimi-k3

# --- Cheap/fast model for SIMPLE tasks (classification, keyword/field extraction) ---
# Leave empty to reuse LLM_MODEL (no behaviour change). Point it at a small/fast
# model or a LOCAL server to cut cost & latency on simple tasks:
#   CHEAP_MODEL=groq/llama-3.1-8b-instant
#   CHEAP_MODEL=ollama/llama3          # local Ollama, zero API cost
CHEAP_MODEL=ollama/qwen2.5:7b-instruct-q4_K_M

# --- LLM token-optimization controls ---
# Cache identical prompts (temperature==0) in memory; hit => skip the call (0 tokens).
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=604800        # 7 days
# Hard cap on prompt+system chars sent to the model (0 = no cap). Long inputs are
# head/tail trimmed. 16000 chars ~= a safe extraction context.
LLM_MAX_INPUT_CHARS=16000

# --- Reasoning Model (for ReAct agent decision-making) ---
# Uses stronger reasoning model for tool-use decisions.
# Examples: gpt-4o, anthropic/claude-3-5-sonnet-20241022, openrouter/deepseek/deepseek-r1
REASONING_MODEL=dashscope/qwen3.8-27b
REASONING_TEMPERATURE=0.2
REASONING_MAX_TOKENS=4096
REASONING_REQUESTS_PER_MINUTE=60
REASONING_MODEL_FALLBACK=dashscope/qwen3.8-max-0902,dashscope/kimi-k3

# --- LLM Provider API Keys (fill in the ones you use) ---
# Recommended default:
#   LLM_MODEL=minimax/MiniMax-M2.1-highspeed
#   REASONING_MODEL=minimax/MiniMax-M2.5
# Apply for MiniMax keys in the MiniMax platform dashboard, then paste them here.
# Base URL guidance:
#   International: https://api.minimax.io/v1
#   China mainland: https://api.minimaxi.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io/v1
# 百炼 / 阿里云 DashScope (qwen3.8 / kimi-k3 等模型均走此网关)
DASHSCOPE_API_KEY=
# 本地 Ollama 服务地址 (小模型 / 兜底)
OLLAMA_API_BASE=http://127.0.0.1:11434

# --- Search ---
# Google Maps search: ALWAYS uses Serper (required if you want Maps results)
SERPER_API_KEY=        # https://serper.dev — dedicated to Google Maps search

# General web search backends. search_agent queries them in a SEQUENTIAL
# FAILOVER chain ordered by SEARCH_PROVIDER_ORDER (or the built-in default in
# agents/search_agent.py). Providers are tried one-by-one per keyword:
#   - returns results        → stop, use that backend
#   - quota/network failure  → remember + auto-switch to the next one
# Tavily supports multiple API keys (comma-separated) for round-robin rotation.
# Example:
#   TAVILY_API_KEY=tvly-dev-xxx,tvly-prod-yyy,tvly-prod-zzz
TAVILY_API_KEY=        # https://tavily.com — e.g. key1,key2,key3
BRAVE_API_KEY=         # https://brave.com/search/api (optional web search backend)
EXA_API_KEY=           # https://exa.ai (semantic search, usage-based)
PARALLEL_API_KEY=      # https://docs.parallel.ai (Parallel Search API)
SERPAPI_API_KEY=       # https://serpapi.com (Google organic search, 100 free/mo)
# Search backend priority (highest first). Providers without a key are ignored.
# Default (when empty): google_maps,serpapi,exa,brave,parallel,tavily
SEARCH_PROVIDER_ORDER=

JINA_API_KEY=          # https://jina.ai (web scraping / Jina Reader)

# --- Crawl de-duplication (unified cross-hunt URL registry) ---
# Stop multiple tasks from re-crawling the same website. A persistent SQLite
# registry records every URL/domain crawled (and by which hunt). Before a task
# is scheduled, its target website is checked; during crawling, already-crawled
# company-site domains are skipped.
CRAWL_DEDUP_ENABLED=true
# Freshness window (seconds). Crawls older than this are allowed again. 0 = never expire.
CRAWL_DEDUP_TTL_SECONDS=2592000          # 30 days
CRAWL_REGISTRY_DB_PATH=data/crawl_registry.db
# Refuse to schedule a task whose target website was already crawled (409).
# Set false to only warn. Force a re-run via force=true on the request.
AUTOMATION_BLOCK_DUPLICATE_TARGET_SITE=true

# --- Blacklist (customers excluded from crawling across all hunts) ---
# Persistent store shared by the crawl pipeline (see tools/blacklist_store.py).
# Records customer_name + official-website domain; domain is the unique key.
# When enabled, search results / crawl targets matching a blacklisted domain are
# dropped at the earliest pipeline stage (search → lead extraction → scrape).
BLACKLIST_DB_PATH=data/blacklist.db
BLACKLIST_FILTER_ENABLED=true

# --- Email ---
# Email generation / campaign / scheduler are available in the current OSS build.
# Recommended:
# - Keep EMAIL_REQUIRE_APPROVAL_BEFORE_SEND=true for safer rollout
# - Test SMTP / IMAP in Settings before enabling auto send / reply detection
EMAIL_FROM_NAME=AI Hunter
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_AUTO_SEND_ENABLED=false
EMAIL_REPLY_DETECTION_ENABLED=false
EMAIL_REQUIRE_APPROVAL_BEFORE_SEND=true
EMAIL_LLM_MODEL=
EMAIL_REASONING_MODEL=
EMAIL_LLM_REQUESTS_PER_MINUTE=0
EMAIL_REASONING_REQUESTS_PER_MINUTE=0

# --- Langfuse (observability, optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=false

# --- Hunt Defaults ---
DEFAULT_TARGET_LEAD_COUNT=200
DEFAULT_MAX_ROUNDS=10
DEFAULT_KEYWORDS_PER_ROUND=8
MIN_NEW_LEADS_THRESHOLD=5

# --- Concurrency ---
SEARCH_CONCURRENCY=10
SCRAPE_CONCURRENCY=5
EMAIL_GEN_CONCURRENCY=3
REACT_MAX_ITERATIONS=5

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
API_ACCESS_TOKEN=
SETTINGS_API_ENABLED=true

# --- Database ---
CHECKPOINT_DB_PATH=hunt_sessions.db

# --- File Upload ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

AUTOMATION_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AUTOMATION_EMBEDDED_CONSUMER_ENABLED=true
AUTOMATION_TEMPLATE_SEED_PREWARM_ENABLED=true
AUTOMATION_CONSUMER_AUTO_START_CAMPAIGN=true
AUTOMATION_SUMMARY_ENABLED=true
AUTOMATION_SUMMARY_INTERVAL_SECONDS=7200
AUTOMATION_ALERTS_ENABLED=true
AUTOMATION_ALERT_INTERVAL_SECONDS=1800
AUTOMATION_ALERT_BACKLOG_THRESHOLD=20
AUTOMATION_ALERT_FAILED_MESSAGES_THRESHOLD=10
AUTOMATION_EVENT_NOTIFICATIONS_ENABLED=true
AUTOMATION_DISCOVERY_BATCH_SIZE=5
AUTOMATION_SEND_BATCH_SIZE=10
AUTOMATION_EVENT_FLUSH_INTERVAL_SECONDS=600
